# Discord Reputation Bot configuration
# Copy this file to data/config.yaml and fill in your server's IDs.
#
# To copy an ID: enable Developer Mode in Discord (User Settings → Advanced),
# then right-click a channel, user or role → Copy ID.
#
# Most of these settings can also be changed from Discord with /settings and
# the admin commands; the bot saves those changes back to this file.

# ═══════════════════════════════════════════════════════════
#                    REQUIRED SETTINGS
# ═══════════════════════════════════════════════════════════

# Your server's ID (right-click the server icon → Copy Server ID).
# Admin commands and admin rights only work in this server, so nobody can
# make themselves an admin by inviting the bot to a server of their own.
guild_id: 123456789012345678

# Forum channels the bot manages (TOS prompt, reviews, auto-close).
# Add more later with /channel_set.
forums:
  - 123456789012345678  # Example: Marketplace forum
  - 987654321098765432  # Example: Services forum

# Channel where the bot logs activity. Use a private staff channel.
# Change later with /log.
log_channel: 123456789012345678

# Bot admins, by user ID. Server administrators are always bot admins,
# so this can start empty.
admin_ids:
  - 123456789012345678

# Roles whose members are bot admins (e.g. Staff, Moderator).
admin_role_ids:
  - 123456789012345678

# ═══════════════════════════════════════════════════════════
#                   TOS AND MESSAGING
# ═══════════════════════════════════════════════════════════

# Shown when someone creates a post. {timeout} becomes a live countdown.
tos_message: |
  Please review our Marketplace Terms of Service in <#123456789012345678>
  and then click ✅ to agree or ❌ to decline.

  If you do not respond within {timeout}, this post will be automatically closed.

# Shown when the post owner declines the TOS (the post is then closed).
tos_decline_response: |
  Marketplace terms not accepted. Thread will now be closed.

# Seconds the post owner has to answer the TOS prompt before the post is closed.
tos_timeout_seconds: 30      # 5-900

# Random lines shown on the review panel for users with no reviews yet.
no_rep_messages:
  - "Damn, get your rep up! 📈"
  - "Zero rep? 🚨 Proceed with caution!"
  - "No rep? Bold move. 🚀"
  - "Are you new here? 🤔"
  - "Fresh meat on the block! 🥩 No rep yet!"
  - "Caution: 0️⃣ reps – untested waters! 🌊"
  - "Certified Ghost Seller 👻 (0 reps)"
  - "They rep nobody… and nobody reps them. 🤷"
  - "Sealed as untested 🚧 Handle with care!"
  - "First sale jitters? 🐣 Zero rep mode!"
  - "Reputation: loading… ⏳ 0/100"
  - "No stars yet ⭐⭐⭐⭐⭐"
  - "They've entered the arena with nothing but vibes. ✨"
  - "New challenger approaches! 🥊 (No rep armor equipped)"
  - "Reputation level: Rookie 🎮"
  - "Trust level: To be determined 📊"
  - "Street cred: Under construction 🚧"
  - "Vouchers needed! 📝 Currently at zero"

# ═══════════════════════════════════════════════════════════
#                     AUTO-CLOSE SETTINGS
# ═══════════════════════════════════════════════════════════

# When a post receives its first review, it is closed automatically after
# auto_close_hours. The post owner gets a button to cancel this (e.g. when
# selling several items in one post).
auto_close_enabled: true
auto_close_hours: 24      # 1-168

# Ask admins to type "Yes" before force-closing someone else's post.
admin_close_confirmation: true

# ═══════════════════════════════════════════════════════════
#                        BOT STATUS
# ═══════════════════════════════════════════════════════════

bot_status:
  enabled: true
  activity_type: "watching"        # playing, listening, watching, competing, streaming
  message: "marketplace reviews"   # e.g. "Watching marketplace reviews"
  status_type: "online"            # online, idle, dnd, invisible
